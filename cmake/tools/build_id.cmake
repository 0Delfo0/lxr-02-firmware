# Writes the build identifier that the boot screen shows under the firmware
# name, so that two images built from different commits can be told apart on
# the device.
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<dir>/fw_build.h -P build_id.cmake
#
# Run at build time, not at configure time: a hash read once when the build
# tree was set up would keep naming an older commit after every commit. The
# header is rewritten only when the identifier changes, so main.c is recompiled
# on a new commit and not on every build.
#
# The abbreviation length is pinned to 7: git widens it on its own in large
# repositories, and the boot screen has 16 columns per line.

find_package(Git QUIET)

set(build_id "local")
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE sha
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE git_result
        ERROR_QUIET
    )
    if(git_result EQUAL 0 AND sha)
        set(build_id "g${sha}")
        # Tracked changes only: an untracked file in the tree does not reach the
        # firmware, a modified tracked one does.
        execute_process(
            COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
            WORKING_DIRECTORY ${SOURCE_DIR}
            OUTPUT_VARIABLE dirty
            RESULT_VARIABLE git_result
            ERROR_QUIET
        )
        if(git_result EQUAL 0 AND NOT dirty STREQUAL "")
            set(build_id "${build_id}+")  # built from uncommitted changes
        endif()
    endif()
endif()

set(content "/* Generated by cmake/tools/build_id.cmake - do not edit, do not commit. */\n")
string(APPEND content "#define FIRMWARE_BUILD \"${build_id}\"\n")

set(previous "")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE ${OUTPUT} "${content}")
    message(STATUS "build id ${build_id}")
endif()
